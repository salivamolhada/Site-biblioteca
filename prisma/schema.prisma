// This is your Prisma schema file for Ateneu BiblioTech
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LIBRARIAN
  ADMIN
}

enum LoanStatus {
  ON_TIME        // Em dia
  DUE_SOON       // Vence em breve (<= 3 dias)
  OVERDUE        // Atrasado
  RETURNED       // Devolvido
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(STUDENT)
  matricula    String?   @unique
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  loans        Loan[]

  @@map("users")
}

model Book {
  id              String    @id @default(uuid())
  title           String
  author          String
  isbn            String    @unique
  genre           String
  publicationYear Int       @map("publication_year")
  description     String    @db.Text
  coverUrl        String?   @map("cover_url")
  location        String?   // Ex: Corredor B, Prateleira 4
  totalCopies     Int       @default(1) @map("total_copies")
  availableCopies Int       @default(1) @map("available_copies")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  loans           Loan[]

  @@index([title])
  @@index([author])
  @@index([genre])
  @@map("books")
}

model Loan {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  bookId      String      @map("book_id")
  borrowedAt  DateTime    @default(now()) @map("borrowed_at")
  dueDate     DateTime    @map("due_date")
  returnedAt  DateTime?   @map("returned_at")
  status      LoanStatus  @default(ON_TIME)
  renewals    Int         @default(0)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@map("loans")
}
