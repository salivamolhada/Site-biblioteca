rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Institutional Library Collections - Colégio Unidade Polo
    match /books/{bookId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /loans/{loanId} {
      allow read, write: if true;
    }

    match /login_activities/{activityId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
